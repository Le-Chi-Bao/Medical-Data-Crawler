{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical-data-crawler:structured-raw:0.1",
  "title": "Structured Raw v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source",
    "original",
    "content",
    "metadata",
    "scope",
    "scope_evidence",
    "audience",
    "audience_evidence",
    "extraction",
    "rights"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "document_id": {
      "$ref": "#/$defs/text"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator",
        "acquired_at",
        "context"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/text"
        },
        "media_type": {
          "$ref": "#/$defs/text"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "level",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "heading",
              "paragraph",
              "list_item",
              "table",
              "text"
            ]
          },
          "level": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "authors",
        "published_on"
      ],
      "properties": {
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "authors": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "published_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "items": {
            "enum": [
              "K01",
              "K02",
              "K03",
              "K04",
              "K05",
              "K06",
              "K07",
              "K08"
            ]
          },
          "uniqueItems": true
        }
      ]
    },
    "scope_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "audience": {
      "enum": [
        "general",
        "medical",
        "mixed",
        "unknown"
      ]
    },
    "audience_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "version",
        "configuration",
        "warnings",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "partial",
            "failed"
          ]
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_basis",
        "reuse",
        "evidence"
      ],
      "properties": {
        "access_basis": {
          "$ref": "#/$defs/text"
        },
        "reuse": {
          "enum": [
            "permitted",
            "restricted",
            "unknown"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "minItems": 1
          },
          "extraction": {
            "properties": {
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "minItems": 1
          },
          "extraction": {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "maxItems": 0
          },
          "extraction": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "audience": {
            "enum": [
              "general",
              "mixed",
              "medical"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "audience_evidence": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "scope_evidence": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights": {
            "properties": {
              "reuse": {
                "enum": [
                  "permitted",
                  "restricted"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
